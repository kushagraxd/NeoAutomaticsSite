# ---------------------------------------------------------------------------
# Sree Raj Tools — environment configuration
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Port the site runs on (defaults to 5000)
PORT=5000

# --- Enquiry (RFQ) email delivery -------------------------------------------
# All five values below must be set for enquiries to be emailed. If any is
# missing, the site does NOT pretend the enquiry was sent: it saves the enquiry
# to uploads/enquiries/ and tells the customer honestly that it could not send.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered
RFQ_TO_EMAIL=

# --- Site URL ---------------------------------------------------------------
# Used to generate sitemap.xml. Run: npm run sitemap
SITE_URL=
